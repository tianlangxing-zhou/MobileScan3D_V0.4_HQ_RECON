<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scan_bg"
    tools:context=".MainActivity">

    <!--
        Camera stays edge-to-edge. Control surfaces are inset at runtime with
        systemBars + displayCutout, so the centered OnePlus 15 punch-hole does
        not require a fragile hard-coded notch size.
    -->
    <FrameLayout
        android:id="@+id/cameraPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

        <com.mobilescan3d.ui.ModelViewerBackdropView
            android:id="@+id/viewerBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Focus UI: camera remains full-bleed; controls occupy only the safe edges. -->
    <LinearLayout
        android:id="@+id/mainScanUi"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/statusCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:background="@drawable/bg_focus_surface"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="扫描状态，点按查看详细信息"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvDepth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:maxLines="2"
                    android:text="深度: 等待"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="≤1.0m"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUnit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:maxLines="2"
                    android:text="非米制"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_focus_surface"
                android:contentDescription="更多扫描工具与设置"
                android:padding="12dp"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/scanWorkspace"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <com.mobilescan3d.ui.ScanReticleView
                android:id="@+id/scanReticle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />

            <com.mobilescan3d.ui.guidance.ScanGuidanceOverlay
                android:id="@+id/scanGuidanceOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvGuidanceStep"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_state_chip"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="92dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="1/4 锁定物体"
                android:textColor="@color/scan_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/toolRail"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:orientation="vertical">
                <!-- Consumer primary action: object tracking must remain one tap away. -->
                <include android:id="@+id/toolLock" layout="@layout/item_scan_tool_lock" />
                <include android:id="@+id/toolLight" layout="@layout/item_scan_tool_light" />
                <include android:id="@+id/toolRealtime" layout="@layout/item_scan_tool_realtime" />
            </LinearLayout>
        </FrameLayout>

        <!-- Warnings participate in layout: they cannot cover the camera controls. -->
        <LinearLayout
            android:id="@+id/scanNotices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvScanHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_hint"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/scan_hint"
                android:textColor="@color/scan_text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionDock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_focus_surface"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvScanStateBadge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="待扫描"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvViewpointSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="视角 0%"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tvScanProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="采集 0%"
                    android:textColor="@color/scan_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/scanProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="采集充分度，非表面覆盖率"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_scan" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnPauseScan"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:minWidth="0dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_secondary"
                    android:drawablePadding="3dp"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="暂停"
                    android:textAllCaps="false"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="12sp"
                    android:visibility="gone" />
                <Button
                    android:id="@+id/btnStartScan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:minWidth="0dp"
                    android:background="@drawable/bg_primary"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="@string/start_scan"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnViewModel"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:minWidth="0dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_secondary"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="模型"
                    android:textAllCaps="false"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!--
        Round 3: Scan Review.
        This is intentionally an overlay on the existing GL/camera surface:
        the user evaluates the actual reconstructed geometry instead of being
        sent to a disconnected summary screen.
    -->
    <FrameLayout
        android:id="@+id/scanReviewOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4A04070B"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="14dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_review_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="11dp"
            android:paddingEnd="14dp"
            android:paddingBottom="11dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="扫描检查"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReviewTopHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:includeFontPadding="false"
                    android:text="检查模型缺口，再决定补扫或生成"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvReviewScore"
                android:layout_width="62dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_state_chip"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="--"
                android:textColor="@color/scan_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/reviewBottomCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_review_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="15dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="本次扫描质量"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReviewRecommendation"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_state_chip"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="建议检查"
                    android:textColor="@color/scan_warning"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvReviewMissing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:text="正在分析缺失视角…"
                android:textColor="@color/scan_text_secondary"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tvSurfaceLegend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_state_chip"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp"
                android:text="表面热力：红=弱观测 · 黄=可用 · 绿=稳定（TSDF真实权重）"
                android:textColor="@color/scan_text_secondary"
                android:textSize="8.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="采集充分"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="9.5sp" />

                <ProgressBar
                    android:id="@+id/reviewProgressCapture"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_scan" />

                <TextView
                    android:id="@+id/tvReviewCapture"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="0%"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="视角覆盖"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="9.5sp" />

                <ProgressBar
                    android:id="@+id/reviewProgressViewpoint"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_scan" />

                <TextView
                    android:id="@+id/tvReviewViewpoint"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="0%"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="表面观测"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="9.5sp" />

                <ProgressBar
                    android:id="@+id/reviewProgressSurface"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_scan" />

                <TextView
                    android:id="@+id/tvReviewSurface"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="0%"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="9.5sp" />
            </LinearLayout>

                <TextView
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="几何稳定"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="9.5sp" />

                <ProgressBar
                    android:id="@+id/reviewProgressGeometry"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_scan" />

                <TextView
                    android:id="@+id/tvReviewGeometry"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="0%"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="纹理质量"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="9.5sp" />

                <ProgressBar
                    android:id="@+id/reviewProgressTexture"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_scan" />

                <TextView
                    android:id="@+id/tvReviewTexture"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="0%"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnReviewDiscard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.72"
                    android:background="@drawable/bg_secondary"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="放弃"
                    android:textAllCaps="false"
                    android:textColor="@color/scan_danger"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnReviewContinue"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.02"
                    android:background="@drawable/bg_secondary"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="继续补扫"
                    android:textAllCaps="false"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnReviewGenerate"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.20"
                    android:background="@drawable/bg_primary"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="生成模型"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>


    <!--
        Round 4 dedicated 3D viewer.
        The live camera texture is hidden while this overlay is active, revealing
        a neutral perspective-grid backdrop behind the transparent GL surface.
    -->
    <FrameLayout
        android:id="@+id/modelViewerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/viewerTopBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="top"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_viewer_bar"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <Button
                android:id="@+id/btnViewerClose"
                android:layout_width="68dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="退出3D模型查看"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="退出"
                android:textAllCaps="false"
                android:textColor="@color/scan_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="3D 模型"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvViewerStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="准备模型…"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnViewerHelp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="3D查看帮助"
                android:padding="11dp"
                android:src="@drawable/ic_help" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/viewerModeStrip"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="82dp"
            android:background="@drawable/bg_viewer_mode_strip"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/viewerModeTexture"
                android:layout_width="50dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_viewer_mode_active"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="纹理"
                android:textColor="@color/scan_text_primary"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/viewerModeSolid"
                android:layout_width="50dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="实体"
                android:textColor="@color/scan_text_secondary"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/viewerModeWire"
                android:layout_width="50dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="线框"
                android:textColor="@color/scan_text_secondary"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/viewerModeInspect"
                android:layout_width="50dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="缺口"
                android:textColor="@color/scan_text_secondary"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/viewerModeSurface"
                android:layout_width="50dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="观测"
                android:textColor="@color/scan_text_secondary"
                android:textSize="9.5sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/viewerRightRail"
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_tool_rail"
            android:orientation="vertical"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/btnViewerReset"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:background="@drawable/bg_tool_item"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="重置视角"
                    android:src="@drawable/ic_reset_view" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:includeFontPadding="false"
                    android:text="重置"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnViewerReport"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_tool_item"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="扫描诊断"
                    android:src="@drawable/ic_pointcloud" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:includeFontPadding="false"
                    android:text="诊断"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnViewerOptimize"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_tool_active"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="一键优化模型"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_optimize" />

                <TextView
                    android:id="@+id/tvViewerOptimizeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:includeFontPadding="false"
                    android:text="优化"
                    android:textColor="@color/scan_primary"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <include
                android:id="@+id/toolPlacement"
                layout="@layout/item_scan_tool_placement" />

            <include
                android:id="@+id/toolRestoreAr"
                layout="@layout/item_scan_tool_restore" />

            <LinearLayout
                android:id="@+id/btnViewerSegment"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_tool_active"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="分段拼接"
                    android:src="@drawable/ic_cube" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:includeFontPadding="false"
                    android:text="分段拼接"
                    android:textColor="@color/scan_primary"
                    android:textSize="8.8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnViewerExport"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:background="@drawable/bg_tool_item"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="导出模型"
                    android:src="@drawable/ic_export" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:includeFontPadding="false"
                    android:text="导出"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/viewerInspectCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="98dp"
            android:layout_marginBottom="72dp"
            android:background="@drawable/bg_viewer_hint"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="9dp"
            android:paddingEnd="12dp"
            android:paddingBottom="9dp">

            <TextView
                android:id="@+id/tvViewerDimensions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="尺寸：分析中"
                android:textColor="@color/scan_text_primary"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvViewerTopology"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:text="拓扑：分析中"
                android:textColor="@color/scan_text_secondary"
                android:textSize="8.8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_viewer_hint"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="9dp"
            android:paddingEnd="16dp"
            android:paddingBottom="9dp">

            <TextView
                android:id="@+id/tvViewerGestureHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="单指旋转 · 双指缩放/平移"
                android:textColor="@color/scan_text_primary"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="右侧可重置视角、AR摆放、恢复AR或导出"
                android:textColor="@color/scan_text_muted"
                android:textSize="8.5sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
