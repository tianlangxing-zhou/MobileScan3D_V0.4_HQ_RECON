<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scan_bg"
    tools:context=".MainActivity">

    <FrameLayout
        android:id="@+id/cameraPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#04070B" />

    <com.mobilescan3d.ui.ScanReticleView
        android:id="@+id/scanReticle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/mainScanUi"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="MobileScan 3D"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:includeFontPadding="false"
                    android:text="@string/version_text"
                    android:textColor="@color/scan_text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_tool"
                android:contentDescription="设置"
                android:padding="11dp"
                android:src="@drawable/ic_settings" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_alignTop="@id/btnSettings"
                android:layout_alignEnd="@id/btnSettings"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_dot_alert" />
        </RelativeLayout>

        <!-- Capture health: metrics that matter while the phone is moving. -->
        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include layout="@layout/item_status_fps" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="34dp"
                    android:background="@color/scan_divider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="距离"
                            android:src="@drawable/ic_nav"
                            android:tint="@color/scan_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:includeFontPadding="false"
                            android:text="距离"
                            android:textColor="@color/scan_text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:includeFontPadding="false"
                        android:text="≤1.0m"
                        android:textColor="@color/scan_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="34dp"
                    android:background="@color/scan_divider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="自动补光"
                            android:src="@drawable/ic_brightness"
                            android:tint="@color/scan_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:includeFontPadding="false"
                            android:text="补光"
                            android:textColor="@color/scan_text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAutoLight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:includeFontPadding="false"
                        android:text="开"
                        android:textColor="@color/scan_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="34dp"
                    android:background="@color/scan_divider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="镜头"
                            android:src="@drawable/ic_viewfinder"
                            android:tint="@color/scan_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:includeFontPadding="false"
                            android:text="镜头"
                            android:textColor="@color/scan_text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCameraMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="自动"
                        android:textColor="@color/scan_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/scan_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="27dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_dot_success" />

                <TextView
                    android:id="@+id/tvDepth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:includeFontPadding="false"
                    android:text="深度: 有效"
                    android:textColor="@color/scan_success"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvMapCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="地图: 0"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvDrawCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:includeFontPadding="false"
                    android:text="绘制: 0"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:includeFontPadding="false"
                    android:text="非米制"
                    android:textColor="@color/scan_text_muted"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/scanWorkspace"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- State is deliberately separated from guidance:
                 "扫描中" answers what the system is doing;
                 the pill below answers what the user should do next. -->
            <TextView
                android:id="@+id/tvScanStateBadge"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_gravity="top|start"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_state_chip"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="62dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="待扫描"
                android:textColor="@color/scan_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScanHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginStart="70dp"
                android:layout_marginEnd="80dp"
                android:background="@drawable/bg_hint"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:paddingStart="13dp"
                android:paddingTop="8dp"
                android:paddingEnd="13dp"
                android:paddingBottom="8dp"
                android:text="@string/scan_hint"
                android:textColor="@color/scan_text_primary"
                android:textSize="10.5sp" />

            <LinearLayout
                android:id="@+id/toolRail"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_tool_rail"
                android:orientation="vertical"
                android:padding="4dp">

                <include android:id="@+id/toolCamera" layout="@layout/item_scan_tool_camera" />
                <include android:id="@+id/toolLock" layout="@layout/item_scan_tool_lock" />
                <include android:id="@+id/toolFocus" layout="@layout/item_scan_tool_focus" />
                <include android:id="@+id/toolPlacement" layout="@layout/item_scan_tool_placement" />
                <include android:id="@+id/toolRealtime" layout="@layout/item_scan_tool_realtime" />
                <include android:id="@+id/toolRestoreAr" layout="@layout/item_scan_tool_restore" />
            </LinearLayout>

            <!-- Round 2 scanner feedback panel.
                 "采集充分度" is intentionally not called geometric coverage:
                 it is a cumulative capture-quality proxy driven by keyframes + stable geometry. -->
            <LinearLayout
                android:id="@+id/hudCard"
                android:layout_width="196dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="2dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_hud"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="采集充分度"
                        android:src="@drawable/ic_pointcloud"
                        android:tint="@color/scan_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="采集充分度"
                        android:textColor="@color/scan_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvScanProgressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="0%"
                        android:textColor="@color/scan_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/scanProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_scan" />

                <TextView
                    android:id="@+id/tvMotionState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:includeFontPadding="false"
                    android:text="移动：待开始"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/tvDistanceState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:includeFontPadding="false"
                    android:text="距离：≤1.0m"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/tvTrackingState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:includeFontPadding="false"
                    android:text="定位：待开始"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="9.5sp" />

                <!-- Kept for existing diagnostics / MainActivity compatibility. -->
                <TextView
                    android:id="@+id/hudCompact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="地图 0 · 绘制 0"
                    android:textColor="@color/scan_text_muted"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <com.mobilescan3d.ui.ViewpointCoverageView
                android:id="@+id/viewpointCoverage"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="7dp"
                android:contentDescription="视角覆盖" />

            <TextView
                android:id="@+id/tvZoom"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="15dp"
                android:background="@drawable/bg_zoom_chip"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="1.0×"
                android:textColor="@color/scan_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- One completion action + a true pause/resume action.
             Export/model remain secondary utilities instead of competing with capture. -->
        <LinearLayout
            android:id="@+id/actionDock"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_bottom_dock"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <Button
                android:id="@+id/btnExport"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="0.68"
                android:background="@drawable/bg_secondary"
                android:drawableStart="@drawable/ic_export"
                android:drawablePadding="5dp"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/export"
                android:textAllCaps="false"
                android:textColor="@color/scan_text_primary"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/btnViewModel"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="7dp"
                android:layout_weight="0.82"
                android:background="@drawable/bg_secondary"
                android:drawableStart="@drawable/ic_cube"
                android:drawablePadding="5dp"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/view_model"
                android:textAllCaps="false"
                android:textColor="@color/scan_text_primary"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/btnPauseScan"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="7dp"
                android:layout_weight="0.72"
                android:background="@drawable/bg_secondary"
                android:drawableStart="@drawable/ic_pause_circle"
                android:drawablePadding="5dp"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="暂停"
                android:textAllCaps="false"
                android:textColor="@color/scan_text_primary"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnStartScan"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginStart="7dp"
                android:layout_weight="1.28"
                android:background="@drawable/bg_primary"
                android:drawableStart="@drawable/ic_scan"
                android:drawablePadding="7dp"
                android:elevation="4dp"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/start_scan"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!--
        Round 3: Scan Review.
        This is intentionally an overlay on the existing GL/camera surface:
        the user evaluates the actual reconstructed geometry instead of being
        sent to a disconnected summary screen.
    -->
    <FrameLayout
        android:id="@+id/scanReviewOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4A04070B"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="14dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_review_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="11dp"
            android:paddingEnd="14dp"
            android:paddingBottom="11dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="扫描检查"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReviewTopHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:includeFontPadding="false"
                    android:text="检查模型缺口，再决定补扫或生成"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvReviewScore"
                android:layout_width="62dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_state_chip"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="--"
                android:textColor="@color/scan_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/reviewBottomCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_review_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="15dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="本次扫描质量"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReviewRecommendation"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_state_chip"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="建议检查"
                    android:textColor="@color/scan_warning"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvReviewMissing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:text="正在分析缺失视角…"
                android:textColor="@color/scan_text_secondary"
                android:textSize="10.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="采集充分"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="9.5sp" />

                <ProgressBar
                    android:id="@+id/reviewProgressCapture"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_scan" />

                <TextView
                    android:id="@+id/tvReviewCapture"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="0%"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="视角覆盖"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="9.5sp" />

                <ProgressBar
                    android:id="@+id/reviewProgressViewpoint"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_scan" />

                <TextView
                    android:id="@+id/tvReviewViewpoint"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="0%"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="几何稳定"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="9.5sp" />

                <ProgressBar
                    android:id="@+id/reviewProgressGeometry"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_scan" />

                <TextView
                    android:id="@+id/tvReviewGeometry"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="0%"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="纹理质量"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="9.5sp" />

                <ProgressBar
                    android:id="@+id/reviewProgressTexture"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_scan" />

                <TextView
                    android:id="@+id/tvReviewTexture"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="0%"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnReviewDiscard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.72"
                    android:background="@drawable/bg_secondary"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="放弃"
                    android:textAllCaps="false"
                    android:textColor="@color/scan_danger"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnReviewContinue"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.02"
                    android:background="@drawable/bg_secondary"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="继续补扫"
                    android:textAllCaps="false"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnReviewGenerate"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.20"
                    android:background="@drawable/bg_primary"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="生成模型"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
