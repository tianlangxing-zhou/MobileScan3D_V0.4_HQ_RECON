<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scan_bg"
    tools:context=".MainActivity">

    <!-- 替换成你当前的 CameraX PreviewView / GLSurfaceView / ARCore Surface -->
    <FrameLayout
        android:id="@+id/cameraPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#05080C" />

    <com.mobilescan3d.ui.ScanReticleView
        android:id="@+id/scanReticle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MobileScan 3D"
                    android:textColor="@color/scan_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/version_text"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_tool"
                android:contentDescription="设置"
                android:padding="12dp"
                android:src="@drawable/ic_settings" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_alignTop="@+id/btnSettings"
                android:layout_alignEnd="@+id/btnSettings"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_dot_alert"/>
        </RelativeLayout>

        <!-- Status card -->
        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include layout="@layout/item_status_fps" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="42dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@color/scan_divider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="距离"
                            android:src="@drawable/ic_nav"
                            android:tint="@color/scan_primary"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="距离"
                            android:textColor="@color/scan_text_secondary"
                            android:textSize="11sp"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="&lt;1.0m"
                        android:textColor="@color/scan_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="42dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@color/scan_divider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="自动补光"
                            android:src="@drawable/ic_brightness"
                            android:tint="@color/scan_primary"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="自动补光"
                            android:textColor="@color/scan_text_secondary"
                            android:textSize="11sp"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvAutoLight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="开"
                        android:textColor="@color/scan_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="42dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@color/scan_divider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="镜头"
                            android:src="@drawable/ic_viewfinder"
                            android:tint="@color/scan_primary"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="镜头"
                            android:textColor="@color/scan_text_secondary"
                            android:textSize="11sp"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvCameraMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="自动"
                        android:textColor="@color/scan_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/scan_divider"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot_success"/>

                <TextView
                    android:id="@+id/tvDepth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="深度: 有效"
                    android:textColor="@color/scan_success"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="10dp"
                    android:background="@color/scan_divider"/>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tvMapCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="地图: 0"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tvDrawCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="绘制: 0"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tvUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="非米制"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Main content -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvScanHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="230dp"
                android:text="@string/scan_hint"
                android:textColor="@color/scan_text_secondary"
                android:textSize="14sp"/>

            <LinearLayout
                android:id="@+id/toolRail"
                android:layout_width="116dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:orientation="vertical">

                <include android:id="@+id/toolCamera" layout="@layout/item_scan_tool_camera"/>
                <include android:id="@+id/toolLock" layout="@layout/item_scan_tool_lock"/>
                <include android:id="@+id/toolFocus" layout="@layout/item_scan_tool_focus"/>
                <include android:id="@+id/toolPlacement" layout="@layout/item_scan_tool_placement"/>
                <include android:id="@+id/toolRealtime" layout="@layout/item_scan_tool_realtime"/>
                <include android:id="@+id/toolRestoreAr" layout="@layout/item_scan_tool_restore"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvZoom"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_circle"
                android:gravity="center"
                android:text="1.0×"
                android:textColor="@color/scan_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/hudCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="点云"
                    android:src="@drawable/ic_pointcloud"
                    android:tint="@color/scan_primary"/>

                <TextView
                    android:id="@+id/hudCompact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:lineSpacingExtra="3dp"
                    android:text="地图 0\n绘制 0\n非米制"
                    android:textColor="@color/scan_text_secondary"
                    android:textSize="11sp"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Bottom action bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnExport"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_weight="0.8"
                android:background="@drawable/bg_secondary"
                android:drawableStart="@drawable/ic_export"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="@string/export"
                android:textAllCaps="false"
                android:textColor="@color/scan_text_primary"
                android:textSize="15sp"/>

            <Button
                android:id="@+id/btnViewModel"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary"
                android:drawableStart="@drawable/ic_cube"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="@string/view_model"
                android:textAllCaps="false"
                android:textColor="@color/scan_text_primary"
                android:textSize="15sp"/>

            <Button
                android:id="@+id/btnStartScan"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1.5"
                android:background="@drawable/bg_primary"
                android:drawableStart="@drawable/ic_scan"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="@string/start_scan"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
