<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#263548" />
            <stroke android:width="1dp" android:color="#506784" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#C818222F" />
            <stroke android:width="1dp" android:color="#35465D" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>
