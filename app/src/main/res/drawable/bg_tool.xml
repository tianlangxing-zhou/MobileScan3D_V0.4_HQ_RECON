<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#EF1B2837" />
            <stroke android:width="1dp" android:color="#48617F" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/scan_tool" />
            <stroke android:width="1dp" android:color="#2B3B50" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
